    "dev": "tsx src/cli.tsx",
    "start": "node dist/cli.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
