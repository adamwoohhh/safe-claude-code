{
  "name": "agent-launcher",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "type": "module",
  "bin": {
    "agent-launch": "./dist/cli.js",
    "al": "./dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc",
